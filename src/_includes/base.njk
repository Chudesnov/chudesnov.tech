<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ (title + " — ") if title }}Sasha Chudesnov</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  {# One level up, set per page with `back: { url, label }`. #}
  {% if back %}
  <header>
    <a class="back" href="{{ back.url }}">← {{ back.label }}</a>
  </header>
  {% endif %}
  <main>
    {{ content | safe }}
  </main>
  {% if page.url != "/" %}
  <footer>
    <a href="mailto:sasha@chudesnov.tech">sasha@chudesnov.tech</a> ·
    <a href="https://linkedin.com/in/chudesnov">LinkedIn</a>
  </footer>
  {% endif %}
</body>
</html>
